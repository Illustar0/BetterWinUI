<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net9.0-windows10.0.26100.0;net10.0-windows10.0.26100.0</TargetFrameworks>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>false</IsAotCompatible>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI"/>
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BetterWinUI.DependencyInjection.PageActivation\BetterWinUI.DependencyInjection.PageActivation.csproj"/>
        <ProjectReference
                Include="..\BetterWinUI.DependencyInjection.PageActivation.Generator\BetterWinUI.DependencyInjection.PageActivation.Generator.csproj"
                OutputItemType="Analyzer"
                ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
