<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageId>BetterWinUI.Navigation.Frame</PackageId>
        <Title>BetterWinUI Navigation for Frame</Title>
        <Description>WinUI Frame navigation adapter for BetterWinUI.Navigation.</Description>
        <PackageTags>BetterWinUI;WinUI;WinUI3;WindowsAppSDK;navigation;Frame;dependency-injection;NativeAOT</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BetterWinUI.Navigation\BetterWinUI.Navigation.csproj"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>
</Project>
