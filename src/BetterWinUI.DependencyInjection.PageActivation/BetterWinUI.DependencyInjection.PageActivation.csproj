<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageId>BetterWinUI.DependencyInjection.PageActivation</PackageId>
        <Title>BetterWinUI Dependency Injection Page Activation</Title>
        <Description>NativeAOT-compatible dependency injection activation for WinUI pages.</Description>
        <PackageTags>BetterWinUI;WinUI;WinUI3;WindowsAppSDK;dependency-injection;page-activation;source-generator;NativeAOT</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
                Include="..\BetterWinUI.DependencyInjection.PageActivation.Generator\BetterWinUI.DependencyInjection.PageActivation.Generator.csproj"
                ReferenceOutputAssembly="false"
                PrivateAssets="all"/>
        <None
                Include="..\BetterWinUI.DependencyInjection.PageActivation.Generator\bin\$(Configuration)\netstandard2.0\BetterWinUI.DependencyInjection.PageActivation.Generator.dll"
                Pack="true"
                PackagePath="analyzers/dotnet/cs"
                Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None
                Include="..\..\third_party\licenses\Scriban.LICENSE.txt"
                Pack="true"
                PackagePath="third_party/licenses/"/>
    </ItemGroup>
</Project>
