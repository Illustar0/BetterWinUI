<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageId>BetterWinUI.Navigation</PackageId>
        <Title>BetterWinUI Navigation</Title>
        <Description>ViewModel-first WinUI Page maps and generated mapping modules.</Description>
        <PackageTags>BetterWinUI;WinUI;WinUI3;WindowsAppSDK;navigation;source-generator;NativeAOT</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI"/>
        <ProjectReference
                Include="..\BetterWinUI.Navigation.Generator\BetterWinUI.Navigation.Generator.csproj"
                ReferenceOutputAssembly="false"
                PrivateAssets="all"/>
        <None
                Include="..\BetterWinUI.Navigation.Generator\bin\$(Configuration)\netstandard2.0\BetterWinUI.Navigation.Generator.dll"
                Pack="true"
                PackagePath="analyzers/dotnet/cs"
                Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None
                Include="..\..\third_party\licenses\Scriban.LICENSE.txt"
                Pack="true"
                PackagePath="third_party/licenses/"/>
    </ItemGroup>
</Project>
