<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageId>BetterWinUI.Navigation</PackageId>
        <Description>Strongly typed navigation destination registration for BetterWinUI.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference
                Include="..\BetterWinUI.Navigation.Generator\BetterWinUI.Navigation.Generator.csproj"
                ReferenceOutputAssembly="false"
                PrivateAssets="all"/>
        <None
                Include="..\BetterWinUI.Navigation.Generator\bin\$(Configuration)\netstandard2.0\BetterWinUI.Navigation.Generator.dll"
                Pack="true"
                PackagePath="analyzers/dotnet/cs"
                Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None
                Include="..\..\third_party\licenses\Scriban.LICENSE.txt"
                Pack="true"
                PackagePath="third_party/licenses/"/>
    </ItemGroup>
</Project>
