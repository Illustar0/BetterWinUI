<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <FalloutRootDirectory>..</FalloutRootDirectory>
        <FalloutScriptDirectory>..</FalloutScriptDirectory>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Fallout.Common" Version="10.4.0" />
        <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>
</Project>
